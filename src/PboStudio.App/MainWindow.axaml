<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PboStudio.App"
        x:Class="PboStudio.App.MainWindow"
        Title="PboStudio – CoreCycler &amp; PBO Curve Optimizer Studio"
        Icon="/icon.png"
        Width="1180" Height="740"
        MinWidth="900" MinHeight="480"
        KeyDown="OnMainWindowKeyDown"
        RequestedThemeVariant="Dark">

  <!-- Row 3 is the splitter; it resizes the star workspace against the bottom dock. The dock
       row stays a pixel row so the splitter keeps working, and the collapse toggle drives its
       height between DockHeightOpen and just the tab strip. It is 150 rather than the old 128
       because three telemetry lanes plus their labels need the room - and at 150 % Windows
       scaling the toggle is what buys the core table its rows back. -->
  <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto,150" Margin="12">

    <!-- ═══════════════════════════════════════════════════════════
         HEADER
         ═══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="0" Classes="card" Padding="12,10" Margin="0,0,0,8">
      <StackPanel Spacing="8">

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

          <!-- Brand + CPU -->
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock Text="PBO" FontSize="17" FontWeight="Black" Foreground="{StaticResource AccentPrimary}" />
              <TextBlock Text="STUDIO" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
            </StackPanel>
            <Border Classes="chip" Background="#16283A" BorderBrush="#1E3A52">
              <TextBlock x:Name="CpuText" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                         Foreground="{StaticResource StateInfo}" Text="Detecting…" />
            </Border>
          </StackPanel>

          <!-- Global actions -->
          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button x:Name="LanguageButton" Classes="secondary" Click="OnToggleLanguage" Content="🌐 EN" />
            <Button x:Name="BiosAuditButton" Classes="secondary" Click="OnShowSystemAuditDetails">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="🔍" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="AuditScoreText" FontSize="{StaticResource FontCaption}" FontWeight="Bold"
                           Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Text="…" />
              </StackPanel>
            </Button>
            <Button x:Name="SetupWizardButton" Classes="secondary" Content="⚙️ Driver &amp; Engines" Click="OnOpenSetupWizard" />
          </StackPanel>

          <!-- Watchdog + live metrics. The watchdog is width-capped and trims, so it can never
               squeeze the telemetry chips off the row; the chips wrap instead of clipping. -->
          <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0" LastChildFill="True">
            <!-- The reset moved here from the removed recommendation card: it belongs next to
                 the count it clears, not in a panel of its own. -->
            <Border x:Name="WatchdogBadgeBorder" DockPanel.Dock="Left" Classes="panel success"
                    Padding="9,5" MaxWidth="420" Margin="0,0,10,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="WatchdogText" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPrimary}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Text="🛡️ WATCHDOG: Monitoring active" />
                <Button x:Name="ResetWheaButton" Classes="ghost" Click="OnResetWheaBaseline"
                        IsVisible="False" VerticalAlignment="Center" Padding="6,2" />
              </StackPanel>
            </Border>

            <WrapPanel x:Name="MetricStrip" ItemWidth="NaN" VerticalAlignment="Center">

              <!-- Temperature leads the strip: it is the only number here that ends a run. -->
              <Border Classes="chip" Margin="0,0,6,4" x:Name="TempChip"
                      BorderThickness="1" BorderBrush="{StaticResource BorderStrong}">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="TempLabel" Classes="metricLabel" Text="TEMP" />
                    <TextBlock x:Name="TempValue" Classes="metricValue" FontWeight="Bold" Text="–" />
                  </StackPanel>
                  <Border Width="72" Height="3" CornerRadius="1" Background="{StaticResource BorderSubtle}" HorizontalAlignment="Left">
                    <Border x:Name="TempBar" Width="0" Height="3" CornerRadius="1"
                            Background="{StaticResource AccentPrimary}" HorizontalAlignment="Left" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="chip" Margin="0,0,6,4" x:Name="BoostChip">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock x:Name="BoostLabel" Classes="metricLabel" Text="CLOCK" />
                  <TextBlock x:Name="BoostValue" Classes="metricValue" Text="–" />
                </StackPanel>
              </Border>

              <Border Classes="chip" Margin="0,0,6,4" x:Name="PptChip">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="metricLabel" Text="PPT" />
                    <TextBlock x:Name="PptValue" Classes="metricValue" Text="–" />
                  </StackPanel>
                  <Border Width="72" Height="2" CornerRadius="1" Background="{StaticResource BorderSubtle}" HorizontalAlignment="Left">
                    <Border x:Name="PptBar" Width="0" Height="2" CornerRadius="1"
                            Background="{StaticResource AccentPrimary}" HorizontalAlignment="Left" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="chip" Margin="0,0,6,4" x:Name="TdcChip">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="metricLabel" Text="TDC" />
                    <TextBlock x:Name="TdcValue" Classes="metricValue" Text="–" />
                  </StackPanel>
                  <Border Width="72" Height="2" CornerRadius="1" Background="{StaticResource BorderSubtle}" HorizontalAlignment="Left">
                    <Border x:Name="TdcBar" Width="0" Height="2" CornerRadius="1"
                            Background="{StaticResource AccentPrimary}" HorizontalAlignment="Left" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="chip" Margin="0,0,6,4" x:Name="EdcChip">
                <StackPanel Spacing="3">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="metricLabel" Text="EDC" />
                    <TextBlock x:Name="EdcValue" Classes="metricValue" Text="–" />
                  </StackPanel>
                  <Border Width="72" Height="2" CornerRadius="1" Background="{StaticResource BorderSubtle}" HorizontalAlignment="Left">
                    <Border x:Name="EdcBar" Width="0" Height="2" CornerRadius="1"
                            Background="{StaticResource AccentPrimary}" HorizontalAlignment="Left" />
                  </Border>
                </StackPanel>
              </Border>

              <Border Classes="chip" Margin="0,0,6,4" x:Name="ScalarChip">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="metricLabel" Text="SCALAR" />
                  <TextBlock x:Name="ScalarValue" Classes="metricValue" Text="–" />
                </StackPanel>
              </Border>

              <TextBlock x:Name="TelemetryOfflineText" Classes="caption" VerticalAlignment="Center"
                         IsVisible="False" Foreground="{StaticResource TextFaint}" />
            </WrapPanel>
          </DockPanel>
        </Grid>

        <!-- Missing dependencies: stated up front, not after a failed start -->
        <Border x:Name="SetupBanner" Classes="panel warning" IsVisible="False">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock Grid.Column="1" x:Name="SetupBannerText" Classes="body"
                       Foreground="{StaticResource StateWarning}" VerticalAlignment="Center" />
            <Button Grid.Column="2" x:Name="SetupBannerButton" Classes="secondary"
                    Click="OnOpenSetupWizard" VerticalAlignment="Center" Margin="10,0,0,0" />
          </Grid>
        </Border>

        <TextBlock x:Name="SupportText" Classes="caption" Foreground="{StaticResource StateWarning}"
                   IsVisible="False" />

        <!-- A fatal machine check that happened while the program was not running. The
             auto-tuner only ever learned from its own test slots; this is the other half. -->
        <Border x:Name="CrashPanel" Classes="panel danger" IsVisible="False">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="💥" FontSize="14" />
              <TextBlock x:Name="CrashTitle" Classes="title" Foreground="{StaticResource StateDanger}" />
            </StackPanel>
            <TextBlock x:Name="CrashText" Classes="body" Foreground="#FECACA" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button x:Name="RecordCrashButton" Classes="primary" Click="OnRecordCrash" />
              <Button x:Name="DismissCrashButton" Classes="secondary" Click="OnDismissCrash" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Interrupted run / BSOD recovery -->
        <Border x:Name="RecoveryPanel" Classes="panel danger" IsVisible="False">
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="⚠️" FontSize="14" />
              <TextBlock x:Name="RecoveryTitle" Classes="title" Foreground="{StaticResource StateDanger}" />
            </StackPanel>
            <TextBlock x:Name="RecoveryText" Classes="body" Foreground="#FECACA" />
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Button x:Name="ResumeRunButton" Classes="primary" Click="OnResumeInterruptedRun" />
              <Button x:Name="DismissRecoveryButton" Classes="secondary" Click="OnDismissRecovery" />
            </StackPanel>
          </StackPanel>
        </Border>
        <!-- A BIOS update invalidates what the tuner remembers. It used to sit inside the
             tuner's settings block; it belongs with the other things that want reading before
             anything is started. -->
        <Border x:Name="BiosChangedPanel" Classes="panel warning" IsVisible="False" Padding="10,7">
          <TextBlock x:Name="BiosChangedText" Classes="caption"
                     Foreground="{StaticResource StateWarning}" TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </Border>

    <!-- ═══════════════════════════════════════════════════════════
         RESULT / DETAIL PANEL — capped and scrollable so a 32-core
         BIOS dump can never push the workspace off screen
         ═══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="1" x:Name="ResultPanel" Classes="panel success" IsVisible="False"
            Padding="12" Margin="0,0,0,8" MaxHeight="260">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="ResultTitle" Classes="title"
                   Foreground="{StaticResource AccentPrimaryHi}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <StackPanel DockPanel.Dock="Bottom" x:Name="ResultActions" Orientation="Horizontal"
                    Spacing="8" IsVisible="False" Margin="0,8,0,0">
          <Button x:Name="AcceptButton" Classes="primary" Click="OnAcceptRecommendation" />
          <Button x:Name="ExportReportButton" Classes="secondary" Click="OnExportReport" />
          <Button x:Name="DismissResultButton" Classes="secondary" Click="OnDismissResult" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <SelectableTextBlock x:Name="ResultText" FontSize="{StaticResource FontBody}"
                               TextWrapping="Wrap" LineHeight="18"
                               Foreground="{StaticResource TextSecondary}" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ═══════════════════════════════════════════════════════════
         WORKSPACE
         ═══════════════════════════════════════════════════════════ -->
    <Grid Grid.Row="2" ColumnDefinitions="*,360" MinHeight="220">

      <!-- ─────────── LEFT: core table ─────────── -->
      <Border Grid.Column="0" Classes="card" Padding="12" Margin="0,0,10,0">
        <DockPanel>

          <!-- The "smart recommendation" card used to sit here: a per-generation lookup that
               announced a target value for every Zen 3 chip alike, next to two other panels
               proposing different numbers for the same core. Its WHEA counts now appear on the
               row they belong to, and the single recommendation lives in the right-hand panel. -->

          <!-- Table header. ColumnDefinitions are assigned in the constructor from the same
               CoreRow.ColumnsFor() the row template binds to, because Avalonia has no
               SharedSizeGroup and two independent "Auto" columns drifted apart. -->
          <Grid DockPanel.Dock="Top" x:Name="CoreTableHeader" ColumnDefinitions="128,126,26,*" Margin="8,0,4,6">
            <StackPanel Grid.Column="0" x:Name="HeaderLabelSpacer" Orientation="Horizontal"
                        Spacing="6" VerticalAlignment="Center">
              <!-- Not IsThreeState: a click must only ever mean all-on or all-off. The
                   indeterminate look still shows for a partial selection, because the
                   pseudo-class follows IsChecked == null regardless. -->
              <CheckBox x:Name="SelectAllBox" IsChecked="True"
                        FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                        Click="OnToggleAllCores" />
              <ItemsControl x:Name="CcdButtons">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <TextBlock x:Name="CoHeaderText" Classes="sectionTitle" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        HorizontalAlignment="Right" Margin="0,0,4,0">
              <Button x:Name="SetAllMaxButton" Classes="ghost" Click="OnSetAllMax" />
              <Button x:Name="SetAllOriginalButton" Classes="ghost" Click="OnSetAllOriginal" />
            </StackPanel>
          </Grid>

          <!-- ── The three ways a value becomes real, side by side and labelled ── -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
            <Border Height="1" Background="{StaticResource BorderSubtle}" />
            <TextBlock x:Name="ApplySectionTitle" Classes="sectionTitle" />
            <!-- The hints wrap to two lines rather than being trimmed. At the 900 px minimum
                 width each column is about 152 px, and "dauerhaft · geplante Aufgabe ·
                 Adminrechte" needs roughly 220 - so the ellipsis hid exactly the part that
                 explains what the option costs. -->
            <Grid ColumnDefinitions="*,12,*,12,*">
              <StackPanel Grid.Column="0" Spacing="3">
                <Button x:Name="ApplyButton" Classes="secondary" HorizontalAlignment="Stretch"
                        Click="OnApplyCurveOptimizer" />
                <TextBlock x:Name="ApplyLiveHint" Classes="caption" TextAlignment="Center"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <Button x:Name="CopyBiosButton" Classes="secondary" HorizontalAlignment="Stretch"
                        Click="OnCopyBiosValues" />
                <TextBlock x:Name="ApplyBiosHint" Classes="caption" TextAlignment="Center"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="3">
                <CheckBox x:Name="AutostartBox" Click="OnToggleAutostart"
                          HorizontalAlignment="Center" MinHeight="28" />
                <TextBlock x:Name="ApplyAutostartHint" Classes="caption" TextAlignment="Center"
                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CoreList">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{StaticResource SurfaceInset}" BorderBrush="#1B202D" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusSm}" Padding="8,1" Margin="0,0,0,2">
                    <StackPanel Spacing="0">
                      <!-- Column 0 is Auto, but the panel inside it is pinned to
                           CoreRow.LabelWidth - the same value the header grid is built from in
                           the constructor. ColumnDefinitions itself cannot be bound. -->
                      <Grid ColumnDefinitions="Auto,126,26,*">

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                    Width="{Binding LabelWidth}" VerticalAlignment="Center">
                          <CheckBox Classes="compact" IsChecked="{Binding Selected}"
                                    AutomationProperties.Name="{Binding CoreName}"
                                    ToolTip.Tip="{Binding SelectTooltip}" />
                          <Border Classes="chip tiny" IsVisible="{Binding HasCcd}"
                                  Background="{Binding CcdBrush}" BorderBrush="Transparent"
                                  ToolTip.Tip="{Binding CcdTooltip}">
                            <TextBlock Text="{Binding CcdLabel}" FontSize="9" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}" />
                          </Border>
                          <TextBlock Text="{Binding CoreName}" FontWeight="SemiBold"
                                     FontSize="{StaticResource FontBody}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding QualityBadge}" IsVisible="{Binding HasQuality}"
                                     FontSize="12" VerticalAlignment="Center"
                                     ToolTip.Tip="{Binding QualityTooltip}" />
                          <TextBlock Text="🔒" IsVisible="{Binding IsLocked}" FontSize="11"
                                     VerticalAlignment="Center" ToolTip.Tip="{Binding LockedTooltip}" />
                        </StackPanel>

                        <!-- FormatString carries the sign: a Curve Optimizer value of +5 shown
                             as "5" is genuinely ambiguous in a column that also holds -30. -->
                        <NumericUpDown Grid.Column="1" Classes="compact" Value="{Binding Margin}"
                                       Minimum="{Binding MinLimit}" Maximum="{Binding MaxLimit}"
                                       Increment="1" FormatString="+0;-0;0" ShowButtonSpinner="True"
                                       BorderBrush="{Binding RiskBrush}" BorderThickness="1"
                                       AutomationProperties.Name="{Binding CoreName}"
                                       ToolTip.Tip="{Binding MarginTooltip}"
                                       VerticalAlignment="Center" />

                        <TextBlock Grid.Column="2" Text="{Binding DeltaLabel}"
                                   Foreground="{Binding DeltaBrush}" FontSize="{StaticResource FontCaption}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   ToolTip.Tip="{Binding DeltaTooltip}" />

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0"
                                    VerticalAlignment="Center">

                          <!-- One line of plain text instead of four marks. A known-bad value, a
                               WHEA count and the chip limit used to show up as separate glyphs
                               plus a colour-only bar, all saying overlapping things at once. -->
                          <Border Classes="chip tiny" IsVisible="{Binding HasAdvisory}"
                                  Background="{Binding AdvisoryBackground}" BorderBrush="Transparent"
                                  ToolTip.Tip="{Binding AdvisoryTooltip}">
                            <TextBlock Text="{Binding Advisory}" FontSize="10"
                                       Foreground="{Binding AdvisoryForeground}" />
                          </Border>

                          <Border Classes="statusPill" Background="{Binding StatusBackground}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding StatusGlyph}" FontSize="{StaticResource FontCaption}"
                                         Foreground="{Binding StatusColor}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Status}" FontSize="{StaticResource FontCaption}"
                                         FontWeight="SemiBold" Foreground="{Binding StatusColor}"
                                         VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>

                          <!-- Where the auto-tuner has been on this core: -25 ✕ · -22 ✕ · -19 ✓ -->
                          <ItemsControl ItemsSource="{Binding TuneTrail}" IsVisible="{Binding HasTrail}"
                                        VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                              <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="3" />
                              </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Classes="chip tiny" Background="{Binding Background}"
                                        BorderBrush="Transparent" ToolTip.Tip="{Binding Tooltip}">
                                  <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="{Binding Label}" FontSize="9" FontWeight="Bold"
                                               FontFamily="{StaticResource FontMono}"
                                               Foreground="{Binding Foreground}" />
                                    <TextBlock Text="{Binding Glyph}" FontSize="9"
                                               Foreground="{Binding Foreground}" />
                                  </StackPanel>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ─────────── RIGHT: test controls ─────────── -->
      <Border Grid.Column="1" Classes="card" Padding="12">
        <DockPanel>

          <!-- No "TEST CONTROLS" heading: the tab right below it already says what this is,
               and a column this narrow cannot afford a row that carries no information. -->
          <!-- Three tabs, in the order somebody needs them. Auto runs the whole thing and
               needs nothing from the reader; Tests is for picking one run yourself; Advanced
               is every knob. The previous arrangement had one "Start" tab above two expert
               tabs, which made the expert tabs look like steps two and three. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,4,*,4,*" Margin="0,0,0,10">
            <RadioButton Grid.Column="0" x:Name="RightTabAutoBtn" Classes="segment"
                         GroupName="RightTabs" IsChecked="True" IsCheckedChanged="OnRightTabChanged" />
            <RadioButton Grid.Column="2" x:Name="RightTabTestsBtn" Classes="segment"
                         GroupName="RightTabs" IsCheckedChanged="OnRightTabChanged" />
            <RadioButton Grid.Column="4" x:Name="RightTabAdvancedBtn" Classes="segment"
                         GroupName="RightTabs" IsCheckedChanged="OnRightTabChanged" />
          </Grid>

          <!-- Progress lives outside the tabs: it must stay visible whichever tab is open -->
          <Border DockPanel.Dock="Top" x:Name="ProgressPanel" Classes="panel info"
                  IsVisible="False" Margin="0,0,0,10">
            <StackPanel Spacing="5">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="TestRunningText" Classes="sectionTitle"
                           Foreground="{StaticResource StateInfo}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ElapsedText" FontSize="{StaticResource FontTitle}"
                           FontWeight="Black" FontFamily="{StaticResource FontMono}"
                           Foreground="{StaticResource TextPrimary}" Text="0:00:00" />
              </Grid>
              <ProgressBar x:Name="RunProgress" Minimum="0" Maximum="100" Value="0" Height="5" />
              <TextBlock x:Name="RemainingText" Classes="caption" Foreground="{StaticResource TextMuted}" />
              <TextBlock x:Name="PhaseText" Classes="caption" Foreground="{StaticResource TextSecondary}" />

              <!-- The tuner's own progress used to live inside its settings block. That block is
                   on the Test tab now, and progress that is only visible on a tab nobody has
                   open is not progress. -->
              <StackPanel x:Name="AutoTunerProgressPanel" Spacing="3" IsVisible="False">
                <TextBlock x:Name="AutoTunerProgressText" Classes="caption"
                           Foreground="{StaticResource AccentAutoHi}" />
                <ProgressBar x:Name="AutoTunerProgressBar" Minimum="0" Maximum="1" Value="0"
                             Height="4" Foreground="{StaticResource AccentAuto}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Sticky footer: how long it will take, then the one call to action. The estimate
               used to live inside the Tests tab, so choosing Auto or Advanced meant starting a
               run of unknown length. It is one control here rather than three copies, and it
               says whatever the tab in front is about to do. -->
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,10,0,0">
            <!-- Two facts: how long, and what will really run after the knobs below have
                 had their say. The sentence explaining what a static test is moved into the
                 tooltip; it was the middle line of a box whose first line is the point. -->
            <Border x:Name="DurationHintBorder" Classes="panel success" Padding="9,7">
              <StackPanel Spacing="2">
                <TextBlock x:Name="DurationHint" FontSize="{StaticResource FontCaption}" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentPrimaryHi}" TextWrapping="Wrap" />
                <TextBlock x:Name="PhasePlanText" Classes="caption" FontFamily="{StaticResource FontMono}"
                           Foreground="{StaticResource TextMuted}" LineHeight="14" />
                <TextBlock x:Name="DurationHintSub" IsVisible="False" />
              </StackPanel>
            </Border>
            <Border x:Name="StartDivider" Height="1" Background="{StaticResource BorderSubtle}" />
            <Button x:Name="StartButton" Classes="primary hero" Click="OnStartStop" />
          </StackPanel>

          <!-- ── Scrollable tab body: the fix for content taller than the panel ── -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Panel>

              <!-- Tab 1: Auto - the whole thing, start to finish, with nothing to decide.
                   Three runs chained: check what the current values do, search every core that
                   still has room, then prove the result under load types the search never used.
                   It survives being stopped and being crashed by phase two, which is phase
                   two's job. -->
              <StackPanel x:Name="RightTabAutoPanel" Spacing="10" IsVisible="True" Margin="0,0,4,0">

                <!-- Nothing can run without a driver and an engine, and a plan next to a dead
                     start button is worse than no plan. -->
                <Border x:Name="AutoSetupCard" Classes="panel warning" IsVisible="False" Padding="12,10">
                  <StackPanel Spacing="7">
                    <TextBlock x:Name="AutoSetupTitle" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                               Foreground="{StaticResource StateWarning}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AutoSetupText" Classes="body"
                               FontSize="{StaticResource FontCaption}" LineHeight="16" />
                    <Button x:Name="AutoSetupButton" Classes="primary" HorizontalAlignment="Stretch"
                            MinHeight="34" Click="OnOpenSetupWizard" />
                  </StackPanel>
                </Border>

                <StackPanel x:Name="AutoPlanPanel" Spacing="9">
                  <TextBlock x:Name="AutoHeadline" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                             Foreground="{StaticResource AccentPrimaryHi}" TextWrapping="Wrap" />
                  <TextBlock x:Name="AutoIntro" Classes="body"
                             FontSize="{StaticResource FontCaption}" LineHeight="16" />

                  <!-- The three phases, with the one it is on marked. A run this long has to say
                       where it is, or stopping it feels like losing the evening. -->
                  <Border Background="{StaticResource SurfaceInset}" CornerRadius="4" Padding="10,9">
                    <StackPanel Spacing="7">
                      <Grid ColumnDefinitions="18,*">
                        <TextBlock Grid.Column="0" x:Name="AutoPhase1Glyph" FontSize="12" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" x:Name="AutoPhase1Text" Classes="caption"
                                   TextWrapping="Wrap" LineHeight="15" />
                      </Grid>
                      <Grid ColumnDefinitions="18,*">
                        <TextBlock Grid.Column="0" x:Name="AutoPhase2Glyph" FontSize="12" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" x:Name="AutoPhase2Text" Classes="caption"
                                   TextWrapping="Wrap" LineHeight="15" />
                      </Grid>
                      <Grid ColumnDefinitions="18,*">
                        <TextBlock Grid.Column="0" x:Name="AutoPhase3Glyph" FontSize="12" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" x:Name="AutoPhase3Text" Classes="caption"
                                   TextWrapping="Wrap" LineHeight="15" />
                      </Grid>
                    </StackPanel>
                  </Border>

                  <TextBlock x:Name="AutoEstimate" Classes="caption" TextWrapping="Wrap" LineHeight="15"
                             Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <!-- What the campaign is for: the values, at the end, ready to type into a BIOS. -->
                <Border x:Name="AutoResultCard" Classes="panel success" IsVisible="False" Padding="12,10">
                  <StackPanel Spacing="8">
                    <TextBlock x:Name="AutoResultTitle" FontSize="{StaticResource FontTitle}" FontWeight="Bold"
                               Foreground="{StaticResource AccentPrimaryHi}" TextWrapping="Wrap" />
                    <TextBlock x:Name="AutoResultText" Classes="body"
                               FontSize="{StaticResource FontCaption}" LineHeight="16" />
                    <Border Background="{StaticResource SurfaceInset}" CornerRadius="4" Padding="9,7">
                      <SelectableTextBlock x:Name="AutoResultValues" FontFamily="{StaticResource FontMono}"
                                           FontSize="{StaticResource FontMicro}" LineHeight="15"
                                           Foreground="{StaticResource TextPrimary}" />
                    </Border>
                    <Button x:Name="AutoCopyBiosButton" Classes="primary" HorizontalAlignment="Stretch"
                            MinHeight="32" Click="OnCopyBiosValues" />
                    <Button x:Name="AutoAgainButton" Classes="ghost" HorizontalAlignment="Left"
                            Click="OnRestartCampaign" />
                  </StackPanel>
                </Border>

                <Button x:Name="AutoStartButton" Classes="primary hero" HorizontalAlignment="Stretch"
                        MinHeight="42" Click="OnAutoStartStop" />

                <TextBlock x:Name="AutoFootnote" Classes="caption" TextWrapping="Wrap" LineHeight="15"
                           Foreground="{StaticResource TextFaint}" />
              </StackPanel>

              <!-- Tab 2: Tests - pick one run and start it. Three things and the button at the
                   bottom: which profile, what it runs, how long that takes. The recommendation
                   card that used to sit on top of this was a second answer to the same question
                   the picker below it was already answering, with its own start button and its
                   own copy of the runtime, refreshed on different events and so eventually
                   disagreeing by a factor of eight. Auto is where advice belongs. -->
              <StackPanel x:Name="RightTabTestsPanel" Spacing="8" IsVisible="False" Margin="0,0,4,0">

                <StackPanel x:Name="ProfilePickerPanel" Spacing="4">
                  <TextBlock x:Name="TestProfileLabel" Classes="label" />
                  <ComboBox x:Name="ProfileBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                            SelectionChanged="OnProfileChanged">
                    <!-- Five entries by default: the ones that actually get somebody from an
                         untested processor to values worth putting in the BIOS. The other nine
                         are variations on those, and fourteen equally-weighted names is not a
                         choice, it is a quiz. -->
                    <ComboBox.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Spacing="1">
                          <TextBlock Text="{Binding Category}" FontSize="9" FontWeight="Bold"
                                     Foreground="{StaticResource TextFaint}"
                                     IsVisible="{Binding Category, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                          <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <CheckBox x:Name="AllProfilesBox" IsCheckedChanged="OnToggleAllProfiles" />

                  <!-- What this profile runs, as one line. The paragraph that used to sit under
                       it in a bordered box is the tooltip on the picker now: it explains a
                       choice already made, which is what a tooltip is for. -->
                  <TextBlock x:Name="ProfileEngineText" FontFamily="{StaticResource FontMono}"
                             FontSize="{StaticResource FontMicro}" TextWrapping="Wrap" LineHeight="14"
                             Margin="2,1,0,0" Foreground="{StaticResource StateInfo}" />
                </StackPanel>



              </StackPanel>

              <!-- Tab 3: Advanced - every knob plus every safety limit -->
              <StackPanel x:Name="RightTabAdvancedPanel" Spacing="10" IsVisible="False" Margin="0,0,4,0">

                <!-- Every knob, in one place. These override whatever the chosen profile set,
                     which is the only reason to come here - and they are grouped, because a
                     single list of ninety-odd controls in the order they happened to be written
                     is a dump, not a settings page. Six headings, in the order somebody works
                     through them: how it searches, how long, what load, in what order, what
                     counts as a failure, and what keeps the machine safe. -->
                <!-- One line, once, at the top: everything below overrides the profile. Without
                     it "Instruction set: SSE" reads as the setting rather than as an override of
                     whatever the chosen profile already asked for. -->
                <TextBlock x:Name="AdvancedIntro" Classes="caption" TextWrapping="Wrap"
                           LineHeight="15" Foreground="{StaticResource TextMuted}" />


                <!-- The step search. It lived on the Tests tab and was called the auto-tuner,
                     one tab away from a tab called Auto, which are two different things: Auto
                     runs all three phases and drives this by itself, this is the search inside
                     phase two. Nobody needs to set it to let Auto work. -->
                <Border Classes="panel auto">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="🤖" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock x:Name="AutoTunerTitleText" Classes="sectionTitle"
                                 Foreground="{StaticResource AccentAutoHi}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox x:Name="AutoTunerModeBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnAutoTunerModeChanged">
                      <ComboBoxItem x:Name="AutoTunerOpt0" />
                      <ComboBoxItem x:Name="AutoTunerOpt1" />
                      <ComboBoxItem x:Name="AutoTunerOpt2" />
                    </ComboBox>

                    <!-- Nothing below here means anything while the tuner is switched off, and
                         it was four rows of it: a headroom spinner, a paragraph explaining the
                         spinner, a memory summary and a reset. -->
                    <StackPanel x:Name="AutoTunerDetailPanel" Spacing="6" IsVisible="False">

                      <!-- Headroom between the measured boundary and the value that gets locked.
                           Without it the user is handed the exact edge the stress test found.
                           The paragraph that explained this is the label's tooltip. -->
                      <!-- Label above, field across the width, like Min/core and Passes. Beside
                           the label in 92 pixels, the two spinner buttons left so little room
                           that "+3" rendered as "+". -->
                      <StackPanel x:Name="GuardbandRow" Spacing="3">
                        <TextBlock x:Name="GuardbandLabel" Classes="label" TextWrapping="Wrap" />
                        <NumericUpDown x:Name="GuardbandBox" Value="3" Minimum="0" Maximum="15"
                                       Increment="1" FormatString="+0;-0;0" HorizontalAlignment="Stretch" />
                      </StackPanel>

                      <!-- What the tuner remembers, and the way to make it forget. Its floor
                           comes from here, so the reader has to be able to see and clear it. -->
                      <Border Height="1" Background="{StaticResource BorderSubtle}" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" x:Name="KnowledgeSummaryText" Classes="caption"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Grid.Column="1" x:Name="ResetKnowledgeButton" Classes="ghost"
                                Click="OnResetKnowledge" VerticalAlignment="Center" Margin="8,0,0,0" />
                      </Grid>
                    </StackPanel>

                    <TextBlock x:Name="GuardbandHint" IsVisible="False" />
                  </StackPanel>
                </Border>


                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,6,0,0" />
                <TextBlock x:Name="AdvancedRuntimeTitle" Classes="sectionTitle" />

                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock x:Name="MinutesLabel" Classes="label" />
                    <NumericUpDown x:Name="MinutesBox" Value="6" Minimum="1" Maximum="600"
                                   Increment="1" FormatString="0" ValueChanged="OnRuntimeChanged" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock x:Name="IterationsLabel" Classes="label" />
                    <NumericUpDown x:Name="IterationsBox" Value="3" Minimum="1" Maximum="999"
                                   Increment="1" FormatString="0" ValueChanged="OnRuntimeChanged" />
                  </StackPanel>
                </Grid>

                <!-- Six fixed minutes only get through part of a preset like Huge, where one
                     full FFT sweep takes 33-51 minutes. This runs each core until the engine
                     has actually been through everything once. -->
                <CheckBox x:Name="AutoRuntimeBox" IsCheckedChanged="OnAutoRuntimeChanged" />

                <StackPanel x:Name="AutoRuntimeCapPanel" Spacing="3" IsVisible="False">
                  <TextBlock x:Name="AutoRuntimeCapLabel" Classes="label" />
                  <NumericUpDown x:Name="AutoRuntimeCapBox" Value="60" Minimum="5" Maximum="600"
                                 Increment="5" FormatString="0" ValueChanged="OnRuntimeChanged" />
                  <TextBlock x:Name="AutoRuntimeCapHint" Classes="caption" />
                </StackPanel>


                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,6,0,0" />
                <TextBlock x:Name="AdvancedLoadTitle" Classes="sectionTitle" />

                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock x:Name="EngineLabel" Classes="label" />
                    <ComboBox x:Name="EngineBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnEngineChanged">
                      <ComboBoxItem x:Name="EngineOptAuto" />
                      <ComboBoxItem Content="Prime95" />
                      <ComboBoxItem Content="y-cruncher" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock x:Name="ThreadsLabel" Classes="label" />
                    <ComboBox x:Name="ThreadsBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnThreadsChanged">
                      <ComboBoxItem x:Name="ThreadOpt0" Content="1 Thread" />
                      <ComboBoxItem x:Name="ThreadOpt1" Content="2 Threads (SMT)" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <!-- One worker, but free to move between both SMT siblings. The scheduler then
                     shifts it back and forth, which neither a hard pin nor two saturated
                     threads produces. Only meaningful at one thread. -->
                <CheckBox x:Name="SpreadSmtBox" />

                <StackPanel x:Name="PrimeOptionsPanel" Spacing="8">
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="ModeLabel" Classes="label" />
                    <ComboBox x:Name="ModeBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                      <ComboBoxItem x:Name="ModeOpt0" Content="SSE (Recommended for CO)" />
                      <ComboBoxItem x:Name="ModeOpt1" Content="AVX" />
                      <ComboBoxItem x:Name="ModeOpt2" Content="AVX2 (High Load)" />
                      <ComboBoxItem x:Name="ModeOpt3" Content="AVX-512 (Zen 4 / Zen 5 Max Load)" />
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Spacing="3">
                    <TextBlock x:Name="FftLabel" Classes="label" />
                    <ComboBox x:Name="FftBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnFftChanged">
                      <ComboBoxItem Content="Smallest (4-21K)" />
                      <ComboBoxItem Content="Small (36-248K)" />
                      <ComboBoxItem Content="Large (426-8192K)" />
                      <ComboBoxItem Content="Huge (8960-32768K)" />
                      <ComboBoxItem Content="All (4-32768K)" />
                      <ComboBoxItem Content="Heavy (4-1344K)" />
                      <ComboBoxItem Content="HeavyShort (4-160K)" />
                      <ComboBoxItem Content="Moderate (1344-4096K)" />
                      <ComboBoxItem x:Name="FftOptCustom" />
                    </ComboBox>

                    <Grid x:Name="CustomFftPanel" IsVisible="False" ColumnDefinitions="*,8,*" Margin="0,3,0,0">
                      <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock x:Name="FftMinLabel" Classes="caption" />
                        <NumericUpDown x:Name="FftMinBox" Value="4" Minimum="4" Maximum="51200"
                                       Increment="4" FormatString="0" ValueChanged="OnCustomFftChanged" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock x:Name="FftMaxLabel" Classes="caption" />
                        <NumericUpDown x:Name="FftMaxBox" Value="32" Minimum="4" Maximum="51200"
                                       Increment="4" FormatString="0" ValueChanged="OnCustomFftChanged" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>

                  <!-- Prime95's TortureMem. Zero keeps the work in cache, which is what exposes
                       an undervolted core; above it the memory controller joins in and the test
                       measures something else. It was written into the config as a constant. -->
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="PrimeMemoryLabel" Classes="label" />
                    <NumericUpDown x:Name="PrimeMemoryBox" Value="0" Minimum="0" Maximum="65536"
                                   Increment="64" FormatString="0" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="PrimeMemoryHint" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </StackPanel>

                <StackPanel x:Name="YcAlgoPanel" Spacing="8" IsVisible="False">
                  <StackPanel Spacing="3">
                    <TextBlock x:Name="YcAlgoLabel" Classes="label" />
                    <ComboBox x:Name="YcAlgoBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                              SelectionChanged="OnYcAlgoChanged">
                      <ComboBoxItem x:Name="YcAlgoOpt0" />
                      <ComboBoxItem x:Name="YcAlgoOpt1" />
                      <ComboBoxItem x:Name="YcAlgoOpt2" />
                      <ComboBoxItem x:Name="YcAlgoOptCustom" />
                    </ComboBox>
                  </StackPanel>

                  <!-- Free algorithm choice. Generated from YCruncherOptions.AllAlgorithms so
                       the list can never drift from the tags actually passed on the command line. -->
                  <ItemsControl x:Name="YcAlgoChecks" IsVisible="False">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>

                  <Grid ColumnDefinitions="*,8,*">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock x:Name="YcSecondsLabel" Classes="label" />
                      <NumericUpDown x:Name="YcSecondsBox" Value="60" Minimum="5" Maximum="600"
                                     Increment="5" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="3">
                      <TextBlock x:Name="YcMemoryLabel" Classes="label" />
                      <ComboBox x:Name="YcMemoryBox" SelectedIndex="1" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Default" />
                        <ComboBoxItem Content="64M" />
                        <ComboBoxItem Content="128M" />
                        <ComboBoxItem Content="256M" />
                        <ComboBoxItem Content="512M" />
                      </ComboBox>
                    </StackPanel>
                  </Grid>

                  <StackPanel Spacing="3">
                    <TextBlock x:Name="YcBinaryLabel" Classes="label" />
                    <ComboBox x:Name="YcBinaryBox" SelectedIndex="0" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="YcBinaryHint" Classes="caption" />
                  </StackPanel>
                </StackPanel>


                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,6,0,0" />
                <TextBlock x:Name="AdvancedSequenceTitle" Classes="sectionTitle" />

                <Grid ColumnDefinitions="*,8,*">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock x:Name="PauseIntervalLabel" Classes="label" />
                    <NumericUpDown x:Name="PauseIntervalBox" Value="30" Minimum="5" Maximum="300"
                                   Increment="5" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="3">
                    <TextBlock x:Name="PauseDurationLabel" Classes="label" />
                    <NumericUpDown x:Name="PauseDurationBox" Value="1" Minimum="1" Maximum="30"
                                   Increment="1" FormatString="0" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="3">
                  <TextBlock x:Name="OrderLabel" Classes="label" />
                  <ComboBox x:Name="OrderBox" SelectedIndex="1" HorizontalAlignment="Stretch"
                            SelectionChanged="OnOrderChanged">
                    <ComboBoxItem x:Name="OrderOpt0" Content="Sequential" />
                    <ComboBoxItem x:Name="OrderOpt1" Content="Alternate" />
                    <ComboBoxItem x:Name="OrderOpt2" Content="Random" />
                    <ComboBoxItem x:Name="OrderOpt3" />
                    <ComboBoxItem x:Name="OrderOpt4" />
                  </ComboBox>

                  <StackPanel x:Name="CustomOrderPanel" IsVisible="False" Spacing="3" Margin="0,3,0,0">
                    <TextBlock x:Name="CustomOrderLabel" Classes="caption" />
                    <TextBox x:Name="CustomOrderBox" Watermark="0, 4, 1, 5"
                             TextChanged="OnCustomOrderChanged" />
                    <TextBlock x:Name="CustomOrderHint" Classes="caption" />
                  </StackPanel>
                </StackPanel>


                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,6,0,0" />
                <TextBlock x:Name="AdvancedFailureTitle" Classes="sectionTitle" />

                <CheckBox x:Name="StopOnErrorBox" />
                <CheckBox x:Name="SkipCoreOnErrorBox" IsChecked="True" />

                <!-- A worker can vanish because an antivirus took it or Windows killed it under
                     memory pressure, neither of which says anything about the Curve Optimizer.
                     CoreCycler calls this treatThreadErrorsAsRealErrors. -->
                <CheckBox x:Name="WorkerFaultsAreErrorsBox" IsChecked="True" />

                <CheckBox x:Name="FlashOnErrorBox" IsChecked="True" />

                <StackPanel Spacing="3">
                  <TextBlock x:Name="PriorityLabel" Classes="label" />
                  <ComboBox x:Name="PriorityBox" SelectedIndex="1" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Name="PriorityOpt0" />
                    <ComboBoxItem x:Name="PriorityOpt1" />
                    <ComboBoxItem x:Name="PriorityOpt2" />
                  </ComboBox>
                  <TextBlock x:Name="PriorityHint" Classes="caption" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="3">
                  <TextBlock x:Name="CoreDelayLabel" Classes="label" />
                  <NumericUpDown x:Name="CoreDelayBox" Value="2" Minimum="0" Maximum="120"
                                 Increment="1" FormatString="0" />
                </StackPanel>

                <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="0,6,0,0" />
                <TextBlock x:Name="AdvancedSafetyTitle" Classes="sectionTitle" />
                <StackPanel Spacing="3">
                  <TextBlock x:Name="MaxTempLabel" Classes="label" />
                  <NumericUpDown x:Name="MaxTempBox" Value="90" Minimum="60" Maximum="105"
                                 Increment="1" FormatString="0" />
                </StackPanel>

                <CheckBox x:Name="TreatWheaAsErrorBox" IsChecked="True" />

                <!-- Parks every other core at 0 while one is under test, so a machine check
                     raised elsewhere cannot be charged to the core being measured. -->
                <CheckBox x:Name="IsolateCoreBox" />

                <Border Classes="panel danger" x:Name="RestorePointPanel">
                  <StackPanel Spacing="6">
                    <CheckBox x:Name="RestorePointBox" IsChecked="True" />
                    <TextBlock x:Name="RestorePointHint" Classes="caption"
                               Foreground="{StaticResource StateDanger}" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="3">
                  <TextBlock x:Name="PostTestActionLabel" Classes="label" />
                  <ComboBox x:Name="PostTestActionBox" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem x:Name="PostOpt0" />
                    <ComboBoxItem x:Name="PostOpt1" />
                    <ComboBoxItem x:Name="PostOpt2" />
                  </ComboBox>
                </StackPanel>

                <StackPanel Spacing="3">
                  <TextBlock x:Name="WebhookLabel" Classes="label" />
                  <TextBox x:Name="WebhookBox" Watermark="https://discord.com/api/webhooks/..." />
                </StackPanel>
              </StackPanel>

            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <GridSplitter Grid.Row="3" x:Name="DockSplitter" ResizeDirection="Rows" />

    <!-- ═══════════════════════════════════════════════════════════
         BOTTOM: telemetry / log
         ═══════════════════════════════════════════════════════════ -->
    <Border Grid.Row="4" Classes="card" Padding="10,8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" x:Name="DockStrip"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,6">
          <ToggleButton Grid.Column="0" x:Name="DockCollapseButton" Classes="ghost"
                        IsChecked="True" Content="⌄" FontSize="13" Padding="7,2" Margin="0,0,6,0"
                        VerticalAlignment="Center" IsCheckedChanged="OnToggleBottomDock" />
          <RadioButton Grid.Column="1" x:Name="TabGraphButton" Classes="segment" GroupName="BottomTabs"
                       IsChecked="True" Padding="12,5" IsCheckedChanged="OnBottomTabChanged" />
          <RadioButton Grid.Column="2" x:Name="TabLogButton" Classes="segment" GroupName="BottomTabs"
                       Padding="12,5" Margin="6,0,0,0" IsCheckedChanged="OnBottomTabChanged">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock x:Name="TabLogText" VerticalAlignment="Center" />
              <!-- Survives a dismissed toast: a warning stays countable until the log is opened -->
              <Border x:Name="LogWarningBadge" Classes="countBadge" IsVisible="False">
                <TextBlock x:Name="LogWarningCount" FontSize="9" FontWeight="Bold"
                           Foreground="#241C08" HorizontalAlignment="Center" />
              </Border>
            </StackPanel>
          </RadioButton>

          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="CopyLogButton" Classes="ghost" Click="OnCopyLog" IsVisible="False" />
            <Button x:Name="OpenLogFolderButton" Classes="ghost" Click="OnOpenLogFolder" IsVisible="False" />
            <Button x:Name="ClearLogButton" Classes="ghost" Click="OnClearLog" IsVisible="False" />
            <TextBlock x:Name="ShortcutsText" Classes="caption" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="6,0,4,0" />
          </StackPanel>
        </Grid>

        <Panel x:Name="BottomContent">
          <local:TelemetryGraphControl x:Name="LiveTelemetryGraph" IsVisible="True" />

          <Border x:Name="LogContainer" IsVisible="False" Background="{StaticResource SurfaceConsole}"
                  BorderBrush="#1C202D" BorderThickness="1" CornerRadius="{StaticResource RadiusSm}" Padding="8">
            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
              <SelectableTextBlock x:Name="LogText" FontFamily="{StaticResource FontMono}"
                                   FontSize="{StaticResource FontCaption}" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" />
            </ScrollViewer>
          </Border>
        </Panel>
      </DockPanel>
    </Border>

    <!-- ═══════════════════════════════════════════════════════════
         TOAST — warnings used to go only to a log tab that is closed
         by default, so a refused action looked like nothing happening
         ═══════════════════════════════════════════════════════════ -->
    <Border x:Name="Toast" Grid.Row="0" Grid.RowSpan="5" Classes="toast" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,64,0,0"
            MaxWidth="620" ZIndex="100">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock x:Name="ToastGlyph" FontSize="15" VerticalAlignment="Center" />
        <TextBlock x:Name="ToastText" Classes="body" MaxWidth="500" VerticalAlignment="Center" />
        <Button x:Name="ToastDismiss" Classes="ghost" Content="✕" Click="OnDismissToast"
                VerticalAlignment="Center" />
      </StackPanel>
    </Border>

  </Grid>
</Window>

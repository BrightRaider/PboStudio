<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- FluentTheme derives check marks, selection and focus from these. Left at the
           default they painted Windows blue into an otherwise emerald system. -->
      <Color x:Key="SystemAccentColor">#10B981</Color>
      <Color x:Key="SystemAccentColorLight1">#34D399</Color>
      <Color x:Key="SystemAccentColorLight2">#6EE7B7</Color>
      <Color x:Key="SystemAccentColorLight3">#A7F3D0</Color>
      <Color x:Key="SystemAccentColorDark1">#059669</Color>
      <Color x:Key="SystemAccentColorDark2">#047857</Color>
      <Color x:Key="SystemAccentColorDark3">#065F46</Color>

      <!-- ══════════════════ SURFACES ══════════════════ -->
      <SolidColorBrush x:Key="SurfaceBase"    Color="#0B0D12" />
      <SolidColorBrush x:Key="SurfaceCard"    Color="#141720" />
      <SolidColorBrush x:Key="SurfaceInset"   Color="#0E1017" />
      <SolidColorBrush x:Key="SurfaceRaised"  Color="#1A1E2B" />
      <SolidColorBrush x:Key="SurfaceControl" Color="#0D0E15" />
      <SolidColorBrush x:Key="SurfaceConsole" Color="#08090D" />

      <SolidColorBrush x:Key="BorderSubtle"   Color="#222838" />
      <SolidColorBrush x:Key="BorderStrong"   Color="#2E374A" />

      <!-- ══════════════════ TEXT ══════════════════ -->
      <SolidColorBrush x:Key="TextPrimary"    Color="#F8FAFC" />
      <SolidColorBrush x:Key="TextSecondary"  Color="#CBD5E1" />
      <SolidColorBrush x:Key="TextMuted"      Color="#94A3B8" />
      <SolidColorBrush x:Key="TextFaint"      Color="#64748B" />

      <!-- ══════════════════ SEMANTIC ACCENTS ══════════════════ -->
      <SolidColorBrush x:Key="AccentPrimary"  Color="#10B981" />
      <SolidColorBrush x:Key="AccentPrimaryHi" Color="#34D399" />
      <SolidColorBrush x:Key="AccentPrimaryBg" Color="#0C1A1A" />

      <SolidColorBrush x:Key="AccentAuto"     Color="#8B5CF6" />
      <SolidColorBrush x:Key="AccentAutoHi"   Color="#A78BFA" />
      <SolidColorBrush x:Key="AccentAutoBg"   Color="#16122A" />

      <SolidColorBrush x:Key="StateInfo"      Color="#38BDF8" />
      <SolidColorBrush x:Key="StateInfoBg"    Color="#0C1924" />
      <SolidColorBrush x:Key="StateWarning"   Color="#FBBF24" />
      <SolidColorBrush x:Key="StateWarningBg" Color="#241C08" />
      <SolidColorBrush x:Key="StateDanger"    Color="#F87171" />
      <SolidColorBrush x:Key="StateDangerHi"  Color="#EF4444" />
      <SolidColorBrush x:Key="StateDangerBg"  Color="#2E1418" />

      <!-- Telemetry series (blue is colour-blind safe; the other two are separated by dash pattern) -->
      <SolidColorBrush x:Key="SeriesClock"    Color="#38BDF8" />
      <SolidColorBrush x:Key="SeriesTemp"     Color="#F97316" />
      <SolidColorBrush x:Key="SeriesPower"    Color="#22D3EE" />

      <!-- ══════════════════ TYPE SCALE ══════════════════ -->
      <FontFamily x:Key="FontUi">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, sans-serif</FontFamily>
      <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

      <x:Double x:Key="FontMicro">10.5</x:Double>
      <x:Double x:Key="FontCaption">11.5</x:Double>
      <x:Double x:Key="FontBody">12.5</x:Double>
      <x:Double x:Key="FontTitle">14</x:Double>
      <x:Double x:Key="FontDisplay">18</x:Double>

      <!-- ══════════════════ SHAPE ══════════════════ -->
      <CornerRadius x:Key="RadiusSm">6</CornerRadius>
      <CornerRadius x:Key="RadiusMd">10</CornerRadius>
      <CornerRadius x:Key="RadiusPill">999</CornerRadius>

      <Thickness x:Key="PadCard">14</Thickness>
      <Thickness x:Key="PadControl">10,5</Thickness>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- ══════════════════════════════════════════════════════════
       WINDOW / GLOBAL
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource SurfaceBase}" />
    <Setter Property="FontFamily" Value="{StaticResource FontUi}" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       CARDS & PANELS
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource SurfaceCard}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
  </Style>

  <!-- Semantic call-out panels: one class, consistent tint + border everywhere -->
  <Style Selector="Border.panel">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="10,8" />
  </Style>
  <Style Selector="Border.panel.success">
    <Setter Property="Background" Value="{StaticResource AccentPrimaryBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
  </Style>
  <Style Selector="Border.panel.info">
    <Setter Property="Background" Value="{StaticResource StateInfoBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource StateInfo}" />
  </Style>
  <Style Selector="Border.panel.warning">
    <Setter Property="Background" Value="{StaticResource StateWarningBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource StateWarning}" />
  </Style>
  <Style Selector="Border.panel.danger">
    <Setter Property="Background" Value="{StaticResource StateDangerBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource StateDangerHi}" />
  </Style>
  <Style Selector="Border.panel.auto">
    <Setter Property="Background" Value="{StaticResource AccentAutoBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentAuto}" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       TYPOGRAPHY CLASSES
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{StaticResource FontMicro}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="18" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{StaticResource FontTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       BUTTONS
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Button">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="{StaticResource PadControl}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
    <Setter Property="Foreground" Value="#04140E" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentPrimaryHi}" />
    <Setter Property="Foreground" Value="#04140E" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1B2A24" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#1E2330" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#2A3243" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="#3D4761" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#171B25" />
    <Setter Property="Foreground" Value="#4A5568" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{StaticResource StateDangerHi}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#DC2626" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <Style Selector="Button.auto">
    <Setter Property="Background" Value="{StaticResource AccentAuto}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.auto:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentAutoHi}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Quiet icon/ghost button, still a legal 26px click target -->
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontSize" Value="{StaticResource FontMicro}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#1E2330" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
  </Style>

  <!-- The one big call to action -->
  <Style Selector="Button.hero">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       SEGMENTED CONTROL (RadioButton) — replaces manual Classes juggling
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="RadioButton.segment">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root"
                Background="{StaticResource SurfaceInset}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSm}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.segment:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="#1E2330" />
  </Style>
  <Style Selector="RadioButton.segment:checked /template/ Border#PART_Root">
    <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
  </Style>
  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="#04140E" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       CHIPS & BADGES
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.chip.tiny">
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="TextBlock.metricLabel">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.metricValue">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Status pill in the core table -->
  <Style Selector="Border.statusPill">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
    <Setter Property="Padding" Value="9,1" />
    <Setter Property="MinWidth" Value="104" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       INPUTS
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="NumericUpDown">
    <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{StaticResource FontBody}" />
  </Style>

  <!-- No fixed Height: a wrapped two-line profile name must not get clipped -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- Table density. Without these the inner PART_TextBox inherits the global TextBox
       metrics and forces every core row to 47px. -->
  <Style Selector="NumericUpDown.compact">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="NumericUpDown.compact /template/ TextBox#PART_TextBox">
    <Setter Property="MinHeight" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="NumericUpDown.compact /template/ ButtonSpinner#PART_Spinner">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ButtonSpinner /template/ RepeatButton">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- FluentTheme pins the checkbox body to 32px inside its own template. A MinHeight on the
       control cannot lower that, so the row height has to be fixed outright. -->
  <Style Selector="CheckBox.compact">
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="4,0,0,0" />
  </Style>
  <Style Selector="CheckBox.compact /template/ Grid#RootGrid">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="FontSize" Value="{StaticResource FontCaption}" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
    <Setter Property="MinHeight" Value="26" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource StateInfo}" />
    <Setter Property="Background" Value="{StaticResource SurfaceControl}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       FOCUS VISUALS — the default adorner is nearly invisible on #0B0D12
       ══════════════════════════════════════════════════════════ -->
  <Style Selector=":is(Control):focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource StateInfo}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="RadioButton.segment:focus-visible /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{StaticResource StateInfo}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ══════════════════════════════════════════════════════════
       SPLITTER
       ══════════════════════════════════════════════════════════ -->
  <Style Selector="GridSplitter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Height" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="SizeNorthSouth" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Height="3" Width="46" CornerRadius="2"
                  Background="{StaticResource BorderStrong}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="GridSplitter:pointerover /template/ Border">
    <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
  </Style>

</Styles>

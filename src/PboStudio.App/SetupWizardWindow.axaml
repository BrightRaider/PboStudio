<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PboStudio.App.SetupWizardWindow"
        Title="PboStudio – Driver &amp; Stress Engines"
        Width="720" Height="640"
        MinWidth="560" MinHeight="400"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="18">

    <!-- Header + overall state -->
    <StackPanel Grid.Row="0" Spacing="8">
      <TextBlock x:Name="HeaderTitle" FontSize="{StaticResource FontDisplay}" FontWeight="Bold"
                 Foreground="{StaticResource TextPrimary}" />
      <TextBlock x:Name="HeaderSubtitle" Classes="body" Foreground="{StaticResource TextMuted}" />

      <Border x:Name="SummaryBanner" Classes="panel success">
        <TextBlock x:Name="SummaryText" FontSize="{StaticResource FontBody}" FontWeight="SemiBold"
                   TextWrapping="Wrap" Foreground="{StaticResource AccentPrimaryHi}" />
      </Border>
    </StackPanel>

    <!-- Content is scrollable: a wrapped multi-line driver error used to push the footer
         out of a fixed, non-resizable window. -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
      <StackPanel Spacing="12" Margin="0,0,6,0">

        <!-- PawnIO -->
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🔌" FontSize="15" VerticalAlignment="Center" />
                <TextBlock x:Name="PawnIoTitle" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="InstallPawnIoButton" Classes="primary" Click="OnDownloadPawnIo" Padding="14,6" />
                <Button x:Name="PawnIoWebButton" Classes="secondary" Click="OnOpenPawnIoWeb" Padding="12,6" />
              </StackPanel>
            </Grid>

            <TextBlock x:Name="PawnIoWhat" Classes="caption" Foreground="{StaticResource TextMuted}"
                       FontSize="{StaticResource FontCaption}" LineHeight="17" />

            <Border Classes="panel warning" Padding="8,6">
              <TextBlock x:Name="PawnIoAdminNote" Classes="caption"
                         Foreground="{StaticResource StateWarning}" FontSize="{StaticResource FontCaption}" />
            </Border>

            <TextBlock x:Name="PawnIoStatusText" Classes="body" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Prime95 -->
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🧮" FontSize="15" VerticalAlignment="Center" />
                <TextBlock x:Name="Prime95Title" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="DownloadPrime95Button" Classes="primary"
                      Click="OnDownloadPrime95" Padding="14,6" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="Prime95What" Classes="caption" Foreground="{StaticResource TextMuted}"
                       FontSize="{StaticResource FontCaption}" LineHeight="17" />
            <TextBlock x:Name="Prime95StatusText" Classes="body" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- y-cruncher -->
        <Border Classes="card" Padding="14">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🥧" FontSize="15" VerticalAlignment="Center" />
                <TextBlock x:Name="YCruncherTitle" Classes="title" VerticalAlignment="Center" />
              </StackPanel>
              <Button Grid.Column="1" x:Name="DownloadYCruncherButton" Classes="primary"
                      Click="OnDownloadYCruncher" Padding="14,6" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="YCruncherWhat" Classes="caption" Foreground="{StaticResource TextMuted}"
                       FontSize="{StaticResource FontCaption}" LineHeight="17" />
            <TextBlock x:Name="YCruncherStatusText" Classes="body" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Progress -->
    <StackPanel Grid.Row="2" x:Name="DownloadProgressPanel" IsVisible="False" Spacing="6" Margin="0,12,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="ProgressLabelText" Classes="label"
                   Foreground="{StaticResource StateInfo}" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
          <Button x:Name="OpenDownloadPageButton" Classes="primary" Click="OnOpenDownloadPage"
                  Padding="10,3" IsVisible="False" />
          <Button x:Name="CancelDownloadButton" Classes="secondary" Click="OnCancelDownload" Padding="10,3" />
        </StackPanel>
      </Grid>
      <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Height="6" />
    </StackPanel>

    <!-- Footer -->
    <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,14,0,0">
      <Button Grid.Column="0" x:Name="InstallAllButton" Classes="primary" Click="OnInstallAll" Padding="16,7" />
      <Button Grid.Column="1" x:Name="RecheckButton" Classes="secondary" Click="OnRecheck"
              Padding="14,7" Margin="8,0,0,0" />
      <Button Grid.Column="3" x:Name="CloseButton" Classes="secondary" Click="OnClose" Padding="18,7" />
    </Grid>
  </Grid>
</Window>

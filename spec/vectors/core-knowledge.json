{
  "schema": 1,
  "area": "core-knowledge",
  "kind": "parity",
  "invariants": ["I1"],
  "source": "tests/PboStudio.Tests/CoreKnowledgeServiceTests.cs",
  "about": "What the tuner remembers per core: the most aggressive value that held (bestPassed) and the least aggressive value that failed (worstFailed). The floor the search may go down to is just above the worst failure, never deeper than the chip limit. 'record' plays a list of results on empty knowledge: {pass: [core, margin]} or {fail: [core, margin]}; the result is the knowledge per core, keyed by core number.",
  "cases": [
    { "name": "with nothing known the floor is the chip limit", "function": "floorFor",
      "input": { "bestPassed": null, "worstFailed": null, "chipLimit": -30 }, "expected": -30 },
    { "name": "a failure raises the floor to just above it", "function": "floorFor",
      "input": { "bestPassed": null, "worstFailed": -27, "chipLimit": -30 }, "expected": -26 },
    { "name": "a failure deeper than the chip limit changes nothing", "function": "floorFor",
      "input": { "bestPassed": null, "worstFailed": -35, "chipLimit": -30 }, "expected": -30 },
    { "name": "a pass alone does not move the floor", "function": "floorFor",
      "input": { "bestPassed": -25, "worstFailed": null, "chipLimit": -30 }, "expected": -30 },
    { "name": "a deeper chip limit leaves room above a failure", "function": "floorFor",
      "input": { "bestPassed": null, "worstFailed": -35, "chipLimit": -50 }, "expected": -34 },

    { "name": "the failed value itself is known bad", "function": "isKnownBad",
      "input": { "worstFailed": -27, "margin": -27 }, "expected": true },
    { "name": "anything deeper than a failure is known bad", "function": "isKnownBad",
      "input": { "worstFailed": -27, "margin": -28 }, "expected": true },
    { "name": "anything shallower than a failure is not known bad", "function": "isKnownBad",
      "input": { "worstFailed": -27, "margin": -26 }, "expected": false },
    { "name": "with no failure nothing is known bad", "function": "isKnownBad",
      "input": { "worstFailed": null, "margin": -40 }, "expected": false },

    { "name": "a pass is remembered", "function": "record",
      "input": { "results": [ { "pass": [0, -20] } ] },
      "expected": { "0": { "bestPassed": -20, "worstFailed": null } } },
    { "name": "a less aggressive pass is not news", "function": "record",
      "input": { "results": [ { "pass": [0, -20] }, { "pass": [0, -15] } ] },
      "expected": { "0": { "bestPassed": -20, "worstFailed": null } } },
    { "name": "a more aggressive pass replaces the best", "function": "record",
      "input": { "results": [ { "pass": [0, -20] }, { "pass": [0, -25] } ] },
      "expected": { "0": { "bestPassed": -25, "worstFailed": null } } },
    { "name": "a failure is remembered", "function": "record",
      "input": { "results": [ { "fail": [1, -27] } ] },
      "expected": { "1": { "bestPassed": null, "worstFailed": -27 } } },
    { "name": "a less aggressive failure than the one on record is not news", "function": "record",
      "input": { "results": [ { "fail": [1, -27] }, { "fail": [1, -30] } ] },
      "expected": { "1": { "bestPassed": null, "worstFailed": -27 } } },
    { "name": "a failure at a shallower value widens the bad region", "function": "record",
      "input": { "results": [ { "fail": [1, -27] }, { "fail": [1, -25] } ] },
      "expected": { "1": { "bestPassed": null, "worstFailed": -25 } } },
    { "name": "a failure at the value that passed clears the pass", "function": "record",
      "input": { "results": [ { "pass": [2, -25] }, { "fail": [2, -25] } ] },
      "expected": { "2": { "bestPassed": null, "worstFailed": -25 } } },
    { "name": "a failure at a shallower value than the best pass clears it", "function": "record",
      "input": { "results": [ { "pass": [2, -30] }, { "fail": [2, -25] } ] },
      "expected": { "2": { "bestPassed": null, "worstFailed": -25 } } },
    { "name": "a failure deeper than the best pass keeps it", "function": "record",
      "input": { "results": [ { "pass": [2, -20] }, { "fail": [2, -25] } ] },
      "expected": { "2": { "bestPassed": -20, "worstFailed": -25 } } },
    { "name": "cores are remembered independently", "function": "record",
      "input": { "results": [ { "pass": [0, -20] }, { "fail": [1, -27] }, { "pass": [1, -20] } ] },
      "expected": { "0": { "bestPassed": -20, "worstFailed": null }, "1": { "bestPassed": -20, "worstFailed": -27 } } },

    { "name": "cores with a known bad value are counted", "function": "coresWithKnownBad",
      "input": { "knowledge": { "0": { "bestPassed": -20, "worstFailed": null }, "1": { "bestPassed": null, "worstFailed": -27 }, "2": { "bestPassed": -20, "worstFailed": -25 } } },
      "expected": 2 },
    { "name": "no knowledge counts no cores", "function": "coresWithKnownBad",
      "input": { "knowledge": {} }, "expected": 0 }
  ]
}

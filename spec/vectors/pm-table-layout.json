{
  "schema": 1,
  "area": "pm-table-layout",
  "kind": "parity",
  "invariants": ["I6", "I12"],
  "source": "tests/PboStudio.Tests/PmTableLayoutTests.cs",
  "about": "Where the live readings sit in the power monitoring table, per processor generation. A table version this program does not know has no layout, never a guessed one. A reading outside any believable range is absent, never a number. 'values' lists the table entries that are set (index to value); every other entry is 0. A value of 'NaN' or 'Infinity' is the float of that name.",
  "cases": [
    { "name": "Zen 3 table version 0x380804", "function": "layoutFor", "input": { "version": 3672068 }, "expected": { "name": "Zen 3", "verified": true } },
    { "name": "Zen 3 table version 0x380805", "function": "layoutFor", "input": { "version": 3672069 }, "expected": { "name": "Zen 3", "verified": true } },
    { "name": "Zen 3 table version 0x380904", "function": "layoutFor", "input": { "version": 3672324 }, "expected": { "name": "Zen 3", "verified": true } },
    { "name": "Zen 3 table version 0x380905", "function": "layoutFor", "input": { "version": 3672325 }, "expected": { "name": "Zen 3", "verified": true } },
    { "name": "Zen 4 gets its own layout and is not verified", "function": "layoutFor", "input": { "version": 5505028 }, "expected": { "name": "Zen 4", "verified": false } },
    { "name": "a Zen 5 table has no layout rather than a guessed one", "function": "layoutFor", "input": { "version": 6422789 }, "expected": null },
    { "name": "a Zen 2 table has no layout", "function": "layoutFor", "input": { "version": 2361603 }, "expected": null },
    { "name": "version zero has no layout", "function": "layoutFor", "input": { "version": 0 }, "expected": null },

    { "name": "the highest index of the Zen 3 layout", "function": "highestIndex", "input": { "layout": "Zen 3" }, "expected": 9 },
    { "name": "the highest index of the Zen 4 layout", "function": "highestIndex", "input": { "layout": "Zen 4" }, "expected": 49 },

    { "name": "Zen 3 reads the values it always did", "function": "read",
      "input": { "layout": "Zen 3", "length": 600, "values": { "0": 142, "1": 58, "2": 95, "3": 26, "4": 90, "5": 57, "8": 130, "9": 112 } },
      "expected": { "pptLimit": 142, "pptNow": 58, "tdcLimit": 95, "tdcNow": 26, "edcLimit": 130, "edcNow": 112, "tempLimit": 90, "tempNow": 57, "hasLimits": true } },
    { "name": "Zen 4 reads temperature and power from where that table keeps them", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "3": 87, "11": 63, "48": 41, "49": 96 } },
      "expected": { "pptLimit": null, "pptNow": 87, "tdcLimit": null, "tdcNow": 41, "edcLimit": null, "edcNow": 96, "tempLimit": null, "tempNow": 63, "hasLimits": false } },
    { "name": "a table too short for the layout yields nothing", "function": "read",
      "input": { "layout": "Zen 4", "length": 20, "values": {} }, "expected": null },

    { "name": "a temperature of 0 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 0 }, "pick": ["tempNow"] }, "expected": { "tempNow": null } },
    { "name": "a temperature of -5 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": -5 }, "pick": ["tempNow"] }, "expected": { "tempNow": null } },
    { "name": "a temperature of 300 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 300 }, "pick": ["tempNow"] }, "expected": { "tempNow": null } },
    { "name": "a temperature of NaN is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": "NaN" }, "pick": ["tempNow"] }, "expected": { "tempNow": null } },
    { "name": "a temperature of infinity is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": "Infinity" }, "pick": ["tempNow"] }, "expected": { "tempNow": null } },
    { "name": "a temperature of 1 is reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 1 }, "pick": ["tempNow"] }, "expected": { "tempNow": 1 } },
    { "name": "a temperature of 45 is reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 45 }, "pick": ["tempNow"] }, "expected": { "tempNow": 45 } },
    { "name": "a temperature of 95 is reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 95 }, "pick": ["tempNow"] }, "expected": { "tempNow": 95 } },
    { "name": "a temperature of 125 is reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "11": 125 }, "pick": ["tempNow"] }, "expected": { "tempNow": 125 } },

    { "name": "power of 0 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "3": 0 }, "pick": ["pptNow"] }, "expected": { "pptNow": null } },
    { "name": "power of -1 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "3": -1 }, "pick": ["pptNow"] }, "expected": { "pptNow": null } },
    { "name": "absurd power of 50000 is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "3": 50000 }, "pick": ["pptNow"] }, "expected": { "pptNow": null } },
    { "name": "power of NaN is not reported", "function": "read",
      "input": { "layout": "Zen 4", "length": 600, "values": { "3": "NaN" }, "pick": ["pptNow"] }, "expected": { "pptNow": null } }
  ]
}

{
  "schema": 1,
  "area": "curve-optimizer-range",
  "kind": "parity",
  "invariants": ["I1", "I14"],
  "source": "tests/PboStudio.Tests/CurveOptimizerRangeTests.cs",
  "about": "How deep a Curve Optimizer value this machine accepts: the standard as a floor, widened by what the processor holds and what the person asks for, pulled back when a write does not stick. -30 is the standard, -50 the widest anyone has claimed.",
  "cases": [
    { "name": "nothing else to go on is the standard", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": null, "readFromHardware": [], "appliedFloor": null }, "expected": -30 },
    { "name": "asking for a deeper range gets it", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -40, "readFromHardware": [], "appliedFloor": null }, "expected": -40 },
    { "name": "asking for a shallower range than the standard is ignored", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -10, "readFromHardware": [], "appliedFloor": null }, "expected": -30 },
    { "name": "nothing goes past the widest anyone has claimed", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -80, "readFromHardware": [], "appliedFloor": null }, "expected": -50 },
    { "name": "a value the processor holds widens the range to include it", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": null, "readFromHardware": [-12, -40, -25], "appliedFloor": null }, "expected": -40 },
    { "name": "values inside the range change nothing", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": null, "readFromHardware": [-5, -20, -30], "appliedFloor": null }, "expected": -30 },
    { "name": "whatever the processor reports still stops at the widest", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": null, "readFromHardware": [-200], "appliedFloor": null }, "expected": -50 },
    { "name": "a write that was clamped pulls the range back", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -45, "readFromHardware": [], "appliedFloor": -40 }, "expected": -40 },
    { "name": "a clamp never narrows below the standard range", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -40, "readFromHardware": [], "appliedFloor": -10 }, "expected": -40 },
    { "name": "a deeper default starts at its own depth when nobody chose anything", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": null, "readFromHardware": [], "appliedFloor": null }, "expected": -50 },
    { "name": "a deeper default can be capped at the standard", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": -30, "readFromHardware": [], "appliedFloor": null }, "expected": -30 },
    { "name": "a deeper default can be capped part of the way", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": -40, "readFromHardware": [], "appliedFloor": null }, "expected": -40 },
    { "name": "choosing the default depth itself changes nothing (deep)", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": -50, "readFromHardware": [], "appliedFloor": null }, "expected": -50 },
    { "name": "choosing the default depth itself changes nothing (standard)", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -30, "readFromHardware": [], "appliedFloor": null }, "expected": -30 },
    { "name": "a deeper default is pulled back to what the board accepts", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": null, "readFromHardware": [], "appliedFloor": -30 }, "expected": -30 },
    { "name": "a person's deep choice is pulled back to what the board accepts", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": -50, "readFromHardware": [], "appliedFloor": -40 }, "expected": -40 },
    { "name": "what the processor holds only ever widens (default deep)", "function": "effective",
      "input": { "modelLimit": -50, "userLimit": null, "readFromHardware": [-10, -20], "appliedFloor": null }, "expected": -50 },
    { "name": "what the processor holds only ever widens (cap overridden by evidence)", "function": "effective",
      "input": { "modelLimit": -30, "userLimit": -30, "readFromHardware": [-45], "appliedFloor": null }, "expected": -45 },

    { "name": "a deep write that reads back as written was kept", "function": "wasKept",
      "input": { "requested": -45, "readBack": -45 }, "expected": true },
    { "name": "a deep write that reads back shallower was clamped", "function": "wasKept",
      "input": { "requested": -45, "readBack": -40 }, "expected": false },
    { "name": "a deep write that reads back as the standard was ignored", "function": "wasKept",
      "input": { "requested": -45, "readBack": -30 }, "expected": false },
    { "name": "a deep write that cannot be read back is no evidence either way", "function": "wasKept",
      "input": { "requested": -45, "readBack": null }, "expected": true },
    { "name": "inside the standard range a mismatch is never second-guessed (-30)", "function": "wasKept",
      "input": { "requested": -30, "readBack": -29 }, "expected": true },
    { "name": "inside the standard range a mismatch is never second-guessed (-10)", "function": "wasKept",
      "input": { "requested": -10, "readBack": 0 }, "expected": true }
  ]
}

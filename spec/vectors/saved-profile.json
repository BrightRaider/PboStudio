{
  "schema": 1,
  "area": "saved-profile",
  "kind": "parity",
  "invariants": ["I10"],
  "source": "tests/PboStudio.Tests (SavedProfileValidator)",
  "about": "What of a saved profile is safe to write back at logon. A profile saved for another processor is not applied at all; a core that does not exist or a value outside what any processor accepts is left out with a reason.",
  "cases": [
    { "name": "a matching profile is used whole", "function": "check",
      "input": { "profileCpu": "AMD Ryzen 7 5800X3D 8-Core Processor", "margins": { "0": -30, "1": -25 }, "currentCpu": "AMD Ryzen 7 5800X3D 8-Core Processor", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "0": -30, "1": -25 }, "problems": [], "wrongProcessor": false } },
    { "name": "another processor gets nothing", "function": "check",
      "input": { "profileCpu": "AMD Ryzen 7 5800X3D 8-Core Processor", "margins": { "0": -30 }, "currentCpu": "AMD Ryzen 7 7800X3D 8-Core Processor", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": {}, "problems": ["saved for \"AMD Ryzen 7 5800X3D 8-Core Processor\", this is \"AMD Ryzen 7 7800X3D 8-Core Processor\""], "wrongProcessor": true } },
    { "name": "case and edge spaces do not matter", "function": "check",
      "input": { "profileCpu": "  amd ryzen 7 5800x3d  ", "margins": { "0": -30 }, "currentCpu": "AMD Ryzen 7 5800X3D", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "0": -30 }, "problems": [], "wrongProcessor": false } },
    { "name": "a core that does not exist is left out", "function": "check",
      "input": { "profileCpu": "X", "margins": { "0": -10, "8": -10 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "0": -10 }, "problems": ["core 8 does not exist on this processor"], "wrongProcessor": false } },
    { "name": "a negative core number is left out", "function": "check",
      "input": { "profileCpu": "X", "margins": { "-1": -10, "1": -10 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "1": -10 }, "problems": ["core -1 does not exist on this processor"], "wrongProcessor": false } },
    { "name": "deeper than the processor accepts", "function": "check",
      "input": { "profileCpu": "X", "margins": { "0": -31, "1": -30 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "1": -30 }, "problems": ["core 0: -31 is outside -30..30"], "wrongProcessor": false } },
    { "name": "above the shallowest", "function": "check",
      "input": { "profileCpu": "X", "margins": { "0": 31 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": {}, "problems": ["core 0: 31 is outside -30..30"], "wrongProcessor": false } },
    { "name": "an X3D part takes nothing positive", "function": "check",
      "input": { "profileCpu": "X", "margins": { "0": 5, "1": 0 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 0 },
      "expected": { "margins": { "1": 0 }, "problems": ["core 0: 5 is outside -30..0"], "wrongProcessor": false } },
    { "name": "problems come in core order", "function": "check",
      "input": { "profileCpu": "X", "margins": { "9": 0, "2": -99, "5": -10 }, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": { "5": -10 }, "problems": ["core 2: -99 is outside -30..30", "core 9 does not exist on this processor"], "wrongProcessor": false } },
    { "name": "an empty profile is empty", "function": "check",
      "input": { "profileCpu": "X", "margins": {}, "currentCpu": "X", "coreCount": 8, "deepest": -30, "shallowest": 30 },
      "expected": { "margins": {}, "problems": [], "wrongProcessor": false } }
  ]
}

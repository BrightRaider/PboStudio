{
  "schema": 1,
  "area": "auto-tuner",
  "kind": "parity",
  "invariants": ["I1", "I11"],
  "source": "tests/PboStudio.Tests/GuardbandTests.cs, AutoTunerServiceTests.cs, AutoTunerApplyMarginTests.cs",
  "about": "The step logic of the per-core search. A pass moves one step deeper until the limit, where the core locks; a failure with a proven value settles back onto it; a failure with nothing proven climbs towards zero and then locks at the first value that holds. The guardband is headroom kept between what a core survived and where it is locked, and never pushes into a positive offset. Modes: 'coarse' steps by 3, 'fine' by 1. The advice texts are not part of the vectors: they are language, not logic.",
  "cases": [
    { "name": "coarse steps by three", "function": "stepSize", "input": { "mode": "coarse" }, "expected": 3 },
    { "name": "fine steps by one", "function": "stepSize", "input": { "mode": "fine" }, "expected": 1 },

    { "name": "headroom moves the locked value away from the boundary", "function": "applyGuardband", "input": { "lastKnownGood": -30, "guardband": 3 }, "expected": -27 },
    { "name": "zero headroom locks the measured boundary itself", "function": "applyGuardband", "input": { "lastKnownGood": -30, "guardband": 0 }, "expected": -30 },
    { "name": "headroom never pushes into a positive offset", "function": "applyGuardband", "input": { "lastKnownGood": -1, "guardband": 3 }, "expected": 0 },
    { "name": "headroom up to exactly zero", "function": "applyGuardband", "input": { "lastKnownGood": -3, "guardband": 3 }, "expected": 0 },
    { "name": "a negative guardband is ignored rather than making things worse", "function": "applyGuardband", "input": { "lastKnownGood": -30, "guardband": -5 }, "expected": -30 },
    { "name": "headroom on a shallower value", "function": "applyGuardband", "input": { "lastKnownGood": -27, "guardband": 3 }, "expected": -24 },

    { "name": "a pass inside the range steps down by one (fine)", "function": "nextStep",
      "input": { "margin": -10, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -11, "locked": false, "passed": true, "state": { "lastKnownGood": -10, "ascending": false } } },
    { "name": "a pass inside the range steps down by three (coarse)", "function": "nextStep",
      "input": { "margin": -10, "passed": true, "mode": "coarse", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -13, "locked": false, "passed": true, "state": { "lastKnownGood": -10, "ascending": false } } },
    { "name": "a step never goes past the limit", "function": "nextStep",
      "input": { "margin": -29, "passed": true, "mode": "coarse", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -30, "locked": false, "passed": true, "state": { "lastKnownGood": -29, "ascending": false } } },
    { "name": "the search itself is unaffected by headroom until something locks", "function": "nextStep",
      "input": { "margin": -10, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 5 },
      "expected": { "nextMargin": -11, "locked": false, "passed": true, "state": { "lastKnownGood": -10, "ascending": false } } },
    { "name": "passing at the limit locks with headroom", "function": "nextStep",
      "input": { "margin": -30, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -27, "locked": true, "passed": true, "state": { "lastKnownGood": -30, "ascending": false } } },
    { "name": "passing at the limit with no headroom locks the measured value", "function": "nextStep",
      "input": { "margin": -30, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 0 },
      "expected": { "nextMargin": -30, "locked": true, "passed": true, "state": { "lastKnownGood": -30, "ascending": false } } },
    { "name": "passing deeper than the limit still locks, with headroom", "function": "nextStep",
      "input": { "margin": -35, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -32, "locked": true, "passed": true, "state": { "lastKnownGood": -35, "ascending": false } } },
    { "name": "a negative guardband locks at the measured limit", "function": "nextStep",
      "input": { "margin": -30, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": -5 },
      "expected": { "nextMargin": -30, "locked": true, "passed": true, "state": { "lastKnownGood": -30, "ascending": false } } },
    { "name": "coming back up after a failure locks at the first value that holds, with headroom", "function": "nextStep",
      "input": { "margin": -25, "passed": true, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": true }, "guardband": 3 },
      "expected": { "nextMargin": -22, "locked": true, "passed": true, "state": { "lastKnownGood": -25, "ascending": true } } },

    { "name": "a failure with a proven value settles back onto it with headroom", "function": "nextStep",
      "input": { "margin": -23, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": -20, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -17, "locked": true, "passed": false, "state": { "lastKnownGood": -20, "ascending": false } } },
    { "name": "a failure with a proven value and no headroom settles onto the proven value", "function": "nextStep",
      "input": { "margin": -23, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": -20, "ascending": false }, "guardband": 0 },
      "expected": { "nextMargin": -20, "locked": true, "passed": false, "state": { "lastKnownGood": -20, "ascending": false } } },
    { "name": "settling back onto a value near zero never goes positive", "function": "nextStep",
      "input": { "margin": -2, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": -1, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": 0, "locked": true, "passed": false, "state": { "lastKnownGood": -1, "ascending": false } } },
    { "name": "a failure with nothing proven steps back up (fine)", "function": "nextStep",
      "input": { "margin": -20, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -19, "locked": false, "passed": false, "state": { "lastKnownGood": null, "ascending": true } } },
    { "name": "a failure with nothing proven steps back up (coarse)", "function": "nextStep",
      "input": { "margin": -20, "passed": false, "mode": "coarse", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": -17, "locked": false, "passed": false, "state": { "lastKnownGood": null, "ascending": true } } },
    { "name": "stepping up never passes zero", "function": "nextStep",
      "input": { "margin": -1, "passed": false, "mode": "coarse", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": 0, "locked": false, "passed": false, "state": { "lastKnownGood": null, "ascending": true } } },
    { "name": "failing at zero means the cause is not the curve", "function": "nextStep",
      "input": { "margin": 0, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": 0, "locked": true, "passed": false, "state": { "lastKnownGood": null, "ascending": true } } },
    { "name": "failing at a positive value goes to zero and locks", "function": "nextStep",
      "input": { "margin": 5, "passed": false, "mode": "fine", "maxLimit": -30, "state": { "lastKnownGood": null, "ascending": false }, "guardband": 3 },
      "expected": { "nextMargin": 0, "locked": true, "passed": false, "state": { "lastKnownGood": null, "ascending": true } } },

    { "name": "the worst case for a core that might have to climb from scratch (fine)", "function": "worstCaseSlots",
      "input": { "margin": -25, "maxLimit": -30, "mode": "fine", "maxPasses": 999, "canClimb": true }, "expected": 26 },
    { "name": "a core with a proven value cannot climb, so only the descent counts", "function": "worstCaseSlots",
      "input": { "margin": -25, "maxLimit": -30, "mode": "fine", "maxPasses": 999, "canClimb": false }, "expected": 6 },
    { "name": "the worst case in coarse mode", "function": "worstCaseSlots",
      "input": { "margin": -25, "maxLimit": -30, "mode": "coarse", "maxPasses": 999, "canClimb": true }, "expected": 10 },
    { "name": "a core already at the limit can still climb the whole way", "function": "worstCaseSlots",
      "input": { "margin": -30, "maxLimit": -30, "mode": "fine", "maxPasses": 999, "canClimb": true }, "expected": 31 },
    { "name": "a core at zero with a proven value only descends", "function": "worstCaseSlots",
      "input": { "margin": 0, "maxLimit": -30, "mode": "fine", "maxPasses": 999, "canClimb": false }, "expected": 31 },
    { "name": "the pass budget caps the estimate", "function": "worstCaseSlots",
      "input": { "margin": -15, "maxLimit": -30, "mode": "fine", "maxPasses": 5, "canClimb": true }, "expected": 5 },
    { "name": "a deeper limit lengthens the worst case", "function": "worstCaseSlots",
      "input": { "margin": -40, "maxLimit": -50, "mode": "fine", "maxPasses": 999, "canClimb": true }, "expected": 41 },
    { "name": "at least one slot is always promised", "function": "worstCaseSlots",
      "input": { "margin": 0, "maxLimit": 0, "mode": "fine", "maxPasses": 0, "canClimb": false }, "expected": 1 }
  ]
}

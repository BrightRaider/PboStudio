{
  "schema": 1,
  "area": "campaign",
  "kind": "parity",
  "invariants": ["I13"],
  "source": "tests/PboStudio.Tests/NextStepServiceTests.cs, CampaignServiceTests.cs",
  "about": "The recommendation for what to run next, and the three-phase campaign built on it. 'recommend' picks setup, then the first measuring run, then the search on the cores that still have room, then the confirmation. 'decide' says whether the campaign runs the next step, is done, stalled, or needs setup. A core has room when it holds a value shallower than where the search would lock it (its floor plus headroom). Stages are InstallDriver, InstallEngine, Discover, Narrow, Confirm; profiles are named by identity.",
  "cases": [
    { "name": "no driver: install it first", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -10, "1": -10 }, "knowledge": {}, "chipLimit": -30, "driverReady": false, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "InstallDriver", "profile": "HeavyFfts", "useAutoTuner": false, "cores": [], "action": "OpenSetup", "showProfile": false } },
    { "name": "a driver but no engine: install an engine", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -10, "1": -10 }, "knowledge": {}, "chipLimit": -30, "driverReady": true, "engineReady": false, "guardband": 0 },
      "expected": { "stage": "InstallEngine", "profile": "HeavyFfts", "useAutoTuner": false, "cores": [], "action": "OpenSetup", "showProfile": false } },
    { "name": "nothing measured yet: the first run validates what is set", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -10, "1": -10 }, "knowledge": {}, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Discover", "profile": "RecommendedCombo", "useAutoTuner": false, "cores": [], "action": "ConfigureRun", "showProfile": true } },
    { "name": "knowledge without a single pass is still nothing measured", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -10, "1": -10 }, "knowledge": { "0": { "bestPassed": null, "worstFailed": -27 } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Discover", "profile": "RecommendedCombo", "useAutoTuner": false, "cores": [], "action": "ConfigureRun", "showProfile": true } },
    { "name": "cores with room left are searched, and only those", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -10, "1": -10 }, "knowledge": { "0": { "bestPassed": -10, "worstFailed": null }, "1": { "bestPassed": -10, "worstFailed": null } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [0, 1], "action": "ConfigureRun", "showProfile": true } },
    { "name": "everything at its floor: confirm", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -30, "1": -30 }, "knowledge": { "0": { "bestPassed": -30, "worstFailed": null }, "1": { "bestPassed": -30, "worstFailed": null } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Confirm", "profile": "Overnight", "useAutoTuner": false, "cores": [], "action": "ConfigureRun", "showProfile": true } },
    { "name": "headroom counts: a core locked with its headroom is finished, the other still has room", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -27, "1": -25 }, "knowledge": { "0": { "bestPassed": -30, "worstFailed": null }, "1": { "bestPassed": -30, "worstFailed": null } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 3 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [1], "action": "ConfigureRun", "showProfile": true } },
    { "name": "a core that crashed is finished just above the failure", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -20, "1": -26 }, "knowledge": { "0": { "bestPassed": -20, "worstFailed": -27 }, "1": { "bestPassed": -20, "worstFailed": -27 } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [0], "action": "ConfigureRun", "showProfile": true } },
    { "name": "a value the core has failed at is measured, and it is searched: the search goes back up", "function": "recommend", "kind": "new",
      "input": { "cores": [0, 1], "margins": { "0": -28, "1": -28 }, "knowledge": { "0": { "bestPassed": null, "worstFailed": -27 }, "1": { "bestPassed": null, "worstFailed": -27 } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [0, 1], "action": "ConfigureRun", "showProfile": true } },
    { "name": "a core below its failure is open even when a neighbour is finished", "function": "recommend", "kind": "new",
      "input": { "cores": [0, 1], "margins": { "0": -30, "1": -30 }, "knowledge": { "0": { "bestPassed": -30, "worstFailed": null }, "1": { "bestPassed": -20, "worstFailed": -25 } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [1], "action": "ConfigureRun", "showProfile": true } },
    { "name": "a core with no margin given is taken as holding zero, which leaves room", "function": "recommend",
      "input": { "cores": [0, 1], "margins": { "0": -30 }, "knowledge": { "0": { "bestPassed": -30, "worstFailed": null }, "1": { "bestPassed": -30, "worstFailed": null } }, "chipLimit": -30, "driverReady": true, "engineReady": true, "guardband": 0 },
      "expected": { "stage": "Narrow", "profile": "HeavyFfts", "useAutoTuner": true, "cores": [1], "action": "ConfigureRun", "showProfile": true } },

    { "name": "the phase numbers", "function": "phaseNumberOf", "input": { "stage": "Discover" }, "expected": 1 },
    { "name": "narrow is phase two", "function": "phaseNumberOf", "input": { "stage": "Narrow" }, "expected": 2 },
    { "name": "confirm is phase three", "function": "phaseNumberOf", "input": { "stage": "Confirm" }, "expected": 3 },
    { "name": "setup stages are no phase", "function": "phaseNumberOf", "input": { "stage": "InstallDriver" }, "expected": 0 },

    { "name": "a signature names the stage and the values of the cores", "function": "signature",
      "input": { "stage": "Narrow", "cores": [0, 2], "margins": { "0": -20, "1": -25, "2": -30 } }, "expected": "Narrow|0:-20,2:-30" },
    { "name": "without cores a signature covers every core, in order", "function": "signature",
      "input": { "stage": "Confirm", "cores": [], "margins": { "2": -30, "0": -20, "1": -25 } }, "expected": "Confirm|0:-20,1:-25,2:-30" },
    { "name": "a core with no value signs as zero", "function": "signature",
      "input": { "stage": "Narrow", "cores": [0, 3], "margins": { "0": -20 } }, "expected": "Narrow|0:-20,3:0" },

    { "name": "backing off puts a failed core above the failure with headroom", "function": "backOffTo",
      "input": { "bestPassed": -20, "worstFailed": -27, "chipLimit": -30, "guardband": 3 }, "expected": -23 },
    { "name": "backing off with no failure goes to the chip limit plus headroom", "function": "backOffTo",
      "input": { "bestPassed": null, "worstFailed": null, "chipLimit": -30, "guardband": 3 }, "expected": -27 },
    { "name": "backing off never goes positive", "function": "backOffTo",
      "input": { "bestPassed": null, "worstFailed": -2, "chipLimit": -30, "guardband": 5 }, "expected": 0 },
    { "name": "backing off ignores a negative guardband", "function": "backOffTo",
      "input": { "bestPassed": null, "worstFailed": -27, "chipLimit": -30, "guardband": -4 }, "expected": -26 },

    { "name": "setup needed is not a run", "function": "decide",
      "input": { "state": { "lastStage": "", "runsDone": 0, "lastSignature": "" }, "step": { "stage": "InstallDriver", "action": "OpenSetup", "cores": [] }, "margins": {}, "lastRunClean": true },
      "expected": { "verdict": "NeedsSetup", "phaseNumber": 0 } },
    { "name": "the first step of a fresh campaign runs", "function": "decide",
      "input": { "state": { "lastStage": "", "runsDone": 0, "lastSignature": "" }, "step": { "stage": "Discover", "action": "ConfigureRun", "cores": [] }, "margins": { "0": -10 }, "lastRunClean": true },
      "expected": { "verdict": "Run", "phaseNumber": 1 } },
    { "name": "a clean confirmation run ends the campaign", "function": "decide",
      "input": { "state": { "lastStage": "Confirm", "runsDone": 3, "lastSignature": "Confirm|0:-30" }, "step": { "stage": "Confirm", "action": "ConfigureRun", "cores": [] }, "margins": { "0": -30 }, "lastRunClean": true },
      "expected": { "verdict": "Done", "phaseNumber": 0 } },
    { "name": "a confirmation run that failed does not end the campaign", "function": "decide",
      "input": { "state": { "lastStage": "Confirm", "runsDone": 3, "lastSignature": "Confirm|0:-30" }, "step": { "stage": "Narrow", "action": "ConfigureRun", "cores": [0] }, "margins": { "0": -27 }, "lastRunClean": false },
      "expected": { "verdict": "Run", "phaseNumber": 2 } },
    { "name": "the same step over the same values twice is a stall", "function": "decide",
      "input": { "state": { "lastStage": "Narrow", "runsDone": 2, "lastSignature": "Narrow|0:-20" }, "step": { "stage": "Narrow", "action": "ConfigureRun", "cores": [0] }, "margins": { "0": -20 }, "lastRunClean": true },
      "expected": { "verdict": "Stalled", "phaseNumber": 0 } },
    { "name": "the same step over changed values is progress", "function": "decide",
      "input": { "state": { "lastStage": "Narrow", "runsDone": 2, "lastSignature": "Narrow|0:-20" }, "step": { "stage": "Narrow", "action": "ConfigureRun", "cores": [0] }, "margins": { "0": -23 }, "lastRunClean": true },
      "expected": { "verdict": "Run", "phaseNumber": 2 } },
    { "name": "no run done yet is never a stall", "function": "decide",
      "input": { "state": { "lastStage": "Narrow", "runsDone": 0, "lastSignature": "Narrow|0:-20" }, "step": { "stage": "Narrow", "action": "ConfigureRun", "cores": [0] }, "margins": { "0": -20 }, "lastRunClean": true },
      "expected": { "verdict": "Run", "phaseNumber": 2 } },
    { "name": "a confirm stage with no completed confirmation runs", "function": "decide",
      "input": { "state": { "lastStage": "Narrow", "runsDone": 1, "lastSignature": "Narrow|0:-30" }, "step": { "stage": "Confirm", "action": "ConfigureRun", "cores": [] }, "margins": { "0": -30 }, "lastRunClean": true },
      "expected": { "verdict": "Run", "phaseNumber": 3 } }
  ]
}

  "source": "src/PboStudio.Core/CampaignEstimate.cs",
  "about": "How long the campaign still has to run, in minutes, from what each core holds now. Phases one and three test every core a fixed number of times; the search only costs the cores with room left, and a core with a value on record that held cannot be walked back up from scratch.",
  "cases": [
    { "name": "a fresh machine, two cores, all three phases", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0, 1], "margins": {}, "knowledge": {}, "chipLimit": -30, "guardband": 3, "fromPhase": 1 },
      "expected": { "total": 812, "perPhase": [[1, 72], [2, 620], [3, 120]] } },
    { "name": "a core already at its target costs the search nothing", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0], "margins": { "0": -27 }, "knowledge": {}, "chipLimit": -30, "guardband": 3, "fromPhase": 2 },
      "expected": { "total": 60, "perPhase": [[2, 0], [3, 60]] } },
    { "name": "a core that could climb costs the longer of the two walks", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0], "margins": { "0": -10 }, "knowledge": {}, "chipLimit": -15, "guardband": 3, "fromPhase": 2 },
      "expected": { "total": 170, "perPhase": [[2, 110], [3, 60]] } },
    { "name": "a core with a value that held cannot climb from scratch", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0], "margins": { "0": -10 }, "knowledge": { "0": { "bestPassed": -10, "worstFailed": null } }, "chipLimit": -15, "guardband": 3, "fromPhase": 2 },
      "expected": { "total": 120, "perPhase": [[2, 60], [3, 60]] } },
    { "name": "a core held below its failure is searched back up: it costs the climb, not nothing", "function": "estimate", "kind": "new",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0], "margins": { "0": -28 }, "knowledge": { "0": { "bestPassed": null, "worstFailed": -27 } }, "chipLimit": -30, "guardband": 0, "fromPhase": 2 },
      "expected": { "total": 350, "perPhase": [[2, 290], [3, 60]] } },
    { "name": "the last phase only", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0, 1, 2], "margins": {}, "knowledge": {}, "chipLimit": -30, "guardband": 3, "fromPhase": 3 },
      "expected": { "total": 180, "perPhase": [[3, 180]] } },
    { "name": "a phase whose profile is missing is left out", "function": "estimate",
      "input": { "profiles": { "HeavyFfts": [10, 1, 1] },
                 "cores": [0], "margins": { "0": -10 }, "knowledge": {}, "chipLimit": -15, "guardband": 3, "fromPhase": 1 },
      "expected": { "total": 110, "perPhase": [[2, 110]] } },
    { "name": "a start before phase one counts from phase one", "function": "estimate",
      "input": { "profiles": { "RecommendedCombo": [6, 3, 2], "HeavyFfts": [10, 1, 1], "Overnight": [60, 1, 1] },
                 "cores": [0], "margins": { "0": -27 }, "knowledge": {}, "chipLimit": -30, "guardband": 3, "fromPhase": -4 },
      "expected": { "total": 96, "perPhase": [[1, 36], [2, 0], [3, 60]] } }
  ]
